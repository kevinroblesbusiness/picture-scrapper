{
  "name": "picture-scrapper-automation",
  "version": "1.0.0",
  "description": "Automated Higgsfield image uploader for Mac",
  "main": "main.js",
  "homepage": "./",
  "author": "Kevin Robles",
  "scripts": {
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "react-eject": "react-scripts eject",
    "electron-start": "wait-on http://localhost:3000 && electron .",
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && sleep 5 && electron .\"",
    "build": "npm run react-build && electron-builder",
    "build-mac": "npm run react-build && electron-builder --mac dmg"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "playwright": "^1.40.0",
    "electron-is-dev": "^2.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "concurrently": "^8.2.2",
    "wait-on": "^7.0.1"
  },
  "build": {
    "appId": "com.kevinrobles.picture-scrapper",
    "productName": "Picture Scrapper Automation",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "sign": false
    }
  }
}
